<mujoco model="three_link_arm">
  <compiler angle="radian" coordinate="local"/>
  <option gravity="0 0 0" timestep="0.01"/>

  <default>
    <joint armature="0.04" damping="0.05" stiffness="0.1" limited="false" />
    <geom density="300" friction="1 0.1 0.1" margin="0.002" rgba="0.8 0.6 0.4 1"/>
  </default>

  <worldbody>
    <!-- Scene lighting -->
    <light name="light" pos="0 0 1.5" dir="0 0 -1" diffuse="0.9 0.9 0.9" specular="0.2 0.2 0.2"/>

    <!-- Support table -->
    <geom name="table" type="box" size="0.5 0.5 0.05" pos="0 0 0.025" rgba="0.7 0.5 0.3 1"/>

    <!-- Robot base -->
    <body name="base" pos="0 0 0.05">
      <!-- First link -->
      <body name="link1" pos="0 0 0.5">
        <joint name="joint1" type="hinge" axis="0 0 1" pos="0 0 0" limited="false"/>
        <geom name="link1_geom" type="capsule" fromto="0 0 0 0.3 0 0" size="0.03"/>

        <!-- Second link, serially connected -->
        <body name="link2" pos="0.3 0 0">
          <joint name="joint2" type="hinge" axis="0 1 0" pos="0 0 0" limited="false"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0.3 0 0" size="0.025"/>

          <!-- Third link, extends dexterity -->
          <body name="link3" pos="0.3 0 0">
            <joint name="joint3" type="hinge" axis="0 1 0" pos="0 0 0" limited="false"/>
            <geom name="link3_geom" type="capsule" fromto="0 0 0 0.25 0 0" size="0.022"/>
            <!-- End-effector-frame -->
            <site name="ee_frame" pos="0.25 0 0" size="0.01" rgba="0 1 0 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="200.0" name="joint1_effort_actuator" joint="joint1"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="200.0" name="joint2_effort_actuator" joint="joint2"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="200.0" name="joint3_effort_actuator" joint="joint3"/>
  </actuator>
</mujoco>
