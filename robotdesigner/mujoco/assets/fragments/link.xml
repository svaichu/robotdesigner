<mujoco model="link">
  <!--
    Generic single-DOF link fragment.
    - Joint axis is set by the composer (default: 0 0 1)
    - Link extends 0.3m along +x from joint origin
    - Tip site at end of link for attaching the next component
    - Actuator is added by the composer (pos or torque)
  -->
  <compiler angle="radian" inertiafromgeom="true"/>
  <worldbody>
    <body name="link">
      <joint name="joint" type="hinge" axis="0 0 1" limited="false" armature="1" damping="3"/>
      <geom name="geom" type="capsule" fromto="0 0 0 1 0 0" size="0.03" density="340" friction="0.9"
            conaffinity="1" condim="1" contype="1" margin="0.001" rgba="0.8 0.6 0.4 1" solimp=".8 .8 .01" solref=".02 1"/>
      <!-- Attachment site for next link -->
      <site name="tip" pos="1 0 0" size="0.01" rgba="0 1 0 1"/>
    </body>
  </worldbody>
</mujoco>
